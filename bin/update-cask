#!/bin/bash
#
# update-cask — (re)generate Casks/<token>.rb from a GitHub release of one of
# the n14395 apps.
#
#   bin/update-cask <token> [vN.N] [--desc "One-line description"] [--push]
#
# <token> is the cask token, which is also the GitHub repository name:
# speedy-fan → github.com/n14395/speedy-fan → Casks/speedy-fan.rb.
# Without a version the latest release is used.
#
# Everything in the cask except `desc` is derived from the release artifact:
# the .dmg's sha256, the .app inside it, its bundle identifier, minimum macOS
# version, CPU architectures, sandbox entitlements and whether it embeds the
# Sparkle updater. `desc` comes from --desc, else from the existing cask, else
# from the GitHub repository's description (gh repo edit <repo> -d "…").
#
# --push commits the cask and pushes this repository, so `brew upgrade` sees
# the new version; each app's `build.sh --publish` calls it that way.
#
# Requires: gh (logged in), hdiutil, plutil, codesign, lipo, python3.

set -euo pipefail

OWNER="n14395"

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "update-cask: $*" >&2; exit 1; }

cd "$(dirname "$0")/.."

token="" tag="" desc="" desc_from_cli=0 push=0
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        --desc) [[ $# -ge 2 ]] || die "--desc needs a value"; desc=$2; desc_from_cli=1; shift ;;
        --desc=*) desc=${1#*=}; desc_from_cli=1 ;;
        --push) push=1 ;;
        -*) die "unknown option: $1" ;;
        *)
            if [[ -z $token ]]; then token=$1
            elif [[ -z $tag ]]; then tag=$1
            else die "unexpected argument: $1"
            fi ;;
    esac
    shift
done
[[ -n $token ]] || { usage >&2; exit 1; }
[[ $token =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "token must be lowercase letters, digits and hyphens (got: $token)"
[[ -z $tag || $tag =~ ^v[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || die "version must look like v1.2 or v1.2.3 (got: $tag)"

repo="$OWNER/$token"
cask="Casks/$token.rb"

if [[ $push -eq 1 ]]; then
    # This directory itself must be the clone, not merely sit inside some
    # enclosing repository, or the commit would land in the wrong place.
    [[ "$(git rev-parse --show-toplevel 2>/dev/null)" == "$(pwd -P)" ]] \
        || die "$PWD is not the top level of a git repository — cannot commit the cask (clone github.com/$OWNER/homebrew-tap here, or drop --push)"
    git remote get-url origin >/dev/null 2>&1 \
        || die "$PWD has no 'origin' remote — cannot push"
fi

# ---------------------------------------------------------------- description
if [[ -z $desc && -f $cask ]]; then
    desc=$(sed -n 's/^  desc "\(.*\)"$/\1/p' "$cask")
fi
if [[ -z $desc ]]; then
    desc=$(gh repo view "$repo" --json description --jq .description 2>/dev/null || true)
    [[ -n $desc ]] && { desc_from_cli=1; echo "==> desc taken from the GitHub description of $repo"; }
fi
[[ -n $desc ]] || die "no description for $token: pass --desc \"…\" or set one on GitHub (gh repo edit $repo -d \"…\")"
if [[ $desc_from_cli -eq 1 ]]; then
    desc=${desc//\\/\\\\}
    desc=${desc//\"/\\\"}
fi

# -------------------------------------------------------------------- release
if [[ -z $tag ]]; then
    tag=$(gh release view -R "$repo" --json tagName --jq .tagName 2>/dev/null) \
        || die "no releases found for $repo"
fi
version=${tag#v}
asset=$(gh release view "$tag" -R "$repo" --json assets \
            --jq '[.assets[].name | select(endswith(".dmg"))] | first // empty') \
    || die "release $tag not found in $repo"
[[ -n $asset ]] || die "release $tag of $repo has no .dmg asset"
echo "==> $repo $tag: $asset"

# ------------------------------------------------------------------- download
tmp=$(mktemp -d "${TMPDIR:-/tmp}/update-cask.XXXXXX")
mnt="$tmp/mnt"
cleanup() {
    if [[ -d $mnt ]] && mount | grep -q " on $mnt "; then
        hdiutil detach "$mnt" -quiet 2>/dev/null || hdiutil detach "$mnt" -force -quiet 2>/dev/null || true
    fi
    rm -rf "$tmp"
}
trap cleanup EXIT

gh release download "$tag" -R "$repo" -p "$asset" -D "$tmp"
sha256=$(shasum -a 256 "$tmp/$asset" | cut -d' ' -f1)

# ------------------------------------------------------------ inspect the app
mkdir "$mnt"
hdiutil attach -nobrowse -readonly -noautoopen -mountpoint "$mnt" "$tmp/$asset" >/dev/null 2>"$tmp/attach.log" \
    || { cat "$tmp/attach.log" >&2; die "could not mount $asset"; }
app=$(find "$mnt" -maxdepth 1 -name '*.app' | head -n 1)
[[ -n $app ]] || die "no .app found at the top level of $asset"
app_name=$(basename "$app")

plist_get() { plutil -extract "$2" raw -o - "$1" 2>/dev/null || true; }
plist="$app/Contents/Info.plist"
bundle_id=$(plist_get "$plist" CFBundleIdentifier)
[[ -n $bundle_id ]] || die "$app_name has no CFBundleIdentifier"
display_name=$(plist_get "$plist" CFBundleDisplayName)
[[ -n $display_name ]] || display_name=$(plist_get "$plist" CFBundleName)
[[ -n $display_name ]] || display_name=${app_name%.app}
min_os=$(plist_get "$plist" LSMinimumSystemVersion)
executable=$(plist_get "$plist" CFBundleExecutable)
archs=$(lipo -archs "$app/Contents/MacOS/$executable" 2>/dev/null || true)
has_sparkle=0; [[ -d "$app/Contents/Frameworks/Sparkle.framework" ]] && has_sparkle=1

entitlements() {  # $1 = bundle → "sandboxed group1 group2…"
    codesign -d --entitlements - --xml "$1" 2>/dev/null | python3 -c '
import plistlib, sys
try:
    e = plistlib.loads(sys.stdin.buffer.read())
except Exception:
    e = {}
print("true" if e.get("com.apple.security.app-sandbox") else "false",
      *(e.get("com.apple.security.application-groups") or []))
'
}
read -r sandboxed groups <<<"$(entitlements "$app")"

# App extensions get their own sandbox containers.
container_ids=("$bundle_id")
for appex in "$app"/Contents/PlugIns/*.appex; do
    [[ -d $appex ]] || continue
    id=$(plist_get "$appex/Contents/Info.plist" CFBundleIdentifier)
    [[ -n $id ]] && container_ids+=("$id")
done

hdiutil detach "$mnt" -quiet

echo "    app=$app_name id=$bundle_id min_os=${min_os:-none} archs=${archs:-?} sandboxed=$sandboxed sparkle=$has_sparkle"

# ------------------------------------------------------------------- derive
macos_symbol() {
    case ${1%%.*} in
        11) echo big_sur ;;
        12) echo monterey ;;
        13) echo ventura ;;
        14) echo sonoma ;;
        15) echo sequoia ;;
        26) echo tahoe ;;
        27) echo golden_gate ;;
        *)  die "unknown macOS major version in LSMinimumSystemVersion: $1 (add it to macos_symbol)" ;;
    esac
}

# The download URL interpolates #{version} wherever the asset name contains
# the version number, so `brew livecheck` and version bumps line up.
url_file=${asset//"$version"/\#\{version\}}
url="https://github.com/$repo/releases/download/v#{version}/$url_file"

if [[ $sandboxed == true ]]; then
    zap=()
    for id in "${container_ids[@]}"; do zap+=("~/Library/Containers/$id"); done
    for g in ${groups:-}; do zap+=("~/Library/Group Containers/$g"); done
else
    zap=(
        "~/Library/Application Support/$bundle_id"
        "~/Library/Application Support/${app_name%.app}"
        "~/Library/Caches/$bundle_id"
        "~/Library/HTTPStorages/$bundle_id"
        "~/Library/Preferences/$bundle_id.plist"
        "~/Library/Saved Application State/$bundle_id.savedState"
    )
fi

# Same order as Homebrew's Cask/ArrayAlphabetization cop: downcased, byte order.
sorted=()
while IFS= read -r p; do sorted+=("$p"); done < <(
    for p in "${zap[@]}"; do
        printf '%s\t%s\n' "$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')" "$p"
    done | LC_ALL=C sort -t $'\t' -k1,1 | cut -f2-
)
zap=("${sorted[@]}")

if [[ -f $cask ]]; then
    old_id=$(sed -n 's/^  uninstall quit: "\(.*\)"$/\1/p' "$cask")
    [[ -z $old_id || $old_id == "$bundle_id" ]] \
        || echo "    note: bundle identifier changed from $old_id to $bundle_id" >&2
fi

# -------------------------------------------------------------------- write
{
    echo "cask \"$token\" do"
    echo "  version \"$version\""
    echo "  sha256 \"$sha256\""
    echo
    echo "  url \"$url\""
    echo "  name \"$display_name\""
    echo "  desc \"$desc\""
    echo "  homepage \"https://github.com/$repo\""
    echo
    echo "  livecheck do"
    echo "    url :url"
    echo "    strategy :github_latest"
    echo "  end"
    echo
    [[ $has_sparkle -eq 1 ]] && echo "  auto_updates true"
    [[ $archs == arm64 ]] && echo "  depends_on arch: :arm64"
    [[ $archs == x86_64 ]] && echo "  depends_on arch: :x86_64"
    [[ -n $min_os ]] && echo "  depends_on macos: :$(macos_symbol "$min_os")"
    echo
    echo "  app \"$app_name\""
    echo
    echo "  uninstall quit: \"$bundle_id\""
    echo
    if [[ ${#zap[@]} -eq 1 ]]; then
        echo "  zap trash: \"${zap[0]}\""
    else
        echo "  zap trash: ["
        for p in "${zap[@]}"; do echo "    \"$p\","; done
        echo "  ]"
    fi
    echo "end"
} > "$cask.tmp"
mv "$cask.tmp" "$cask"
echo "    wrote $cask"

# -------------------------------------------------------------------- push
[[ $push -eq 1 ]] || exit 0
git add -- "$cask"
if git diff --cached --quiet -- "$cask"; then
    echo "    $cask is unchanged; nothing to commit"
    exit 0
fi
git commit -q -m "$token $version" -- "$cask"
git push -q origin HEAD
echo "    committed and pushed: $token $version"
